{
  "name": "Clarity",
  "short": "clarity",
  "description": "简洁、清晰的公开状态页，支持多种节点视图与站点级设置",
  "version": "0.2.1",
  "author": "kure29",
  "url": "https://github.com/kure29/Monitor-Theme-Apple",
  "config": [
    { "type": "title", "label": "节点展示" },
    {
      "key": "card_mode",
      "type": "select",
      "label": "默认节点视图",
      "default": "large",
      "options": [
        { "value": "large", "label": "大卡片" },
        { "value": "compact", "label": "小卡片" },
        { "value": "mini", "label": "迷你卡片" },
        { "value": "list", "label": "列表" }
      ]
    },
    {
      "key": "show_summary",
      "type": "boolean",
      "label": "显示顶部概览",
      "default": true
    }
  ]
}
