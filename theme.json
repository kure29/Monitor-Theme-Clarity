{
  "name": "Clarity",
  "short": "clarity",
  "description": "简洁、清晰的公开状态页，支持多种节点视图与站点级设置",
  "version": "0.2.4",
  "author": "kure29",
  "url": "https://github.com/kure29/Monitor-Theme-Clarity",
  "config": [
    { "type": "title", "label": "节点展示" },
    {
      "key": "card_mode",
      "type": "select",
      "label": "节点展示方式",
      "default": "large",
      "options": [
        { "value": "large", "label": "大卡片" },
        { "value": "compact", "label": "小卡片" },
        { "value": "mini", "label": "迷你卡片" },
        { "value": "list", "label": "列表" }
      ]
    },
    {
      "key": "show_summary",
      "type": "boolean",
      "label": "显示顶部概览",
      "default": true
    },
    { "type": "title", "label": "三网延迟" },
    {
      "key": "show_carrier_latency",
      "type": "boolean",
      "label": "在节点视图显示三网延迟",
      "default": true
    },
    { "key": "carrier_telecom", "type": "string", "label": "电信探测任务名称包含", "default": "电信" },
    { "key": "carrier_unicom", "type": "string", "label": "联通探测任务名称包含", "default": "联通" },
    { "key": "carrier_mobile", "type": "string", "label": "移动探测任务名称包含", "default": "移动" }
  ]
}
