{
  "name": "Clarity",
  "short": "clarity",
  "description": "简洁、清晰的公开状态页，支持多种节点视图与站点级设置",
  "version": "0.2.7",
  "author": "kure29",
  "url": "https://github.com/kure29/Monitor-Theme-Clarity",
  "config": [
    { "type": "title", "label": "节点展示" },
    {
      "key": "card_mode",
      "type": "select",
      "label": "节点展示方式",
      "default": "large",
      "options": [
        { "value": "large", "label": "大卡片" },
        { "value": "compact", "label": "小卡片" },
        { "value": "mini", "label": "迷你卡片" },
        { "value": "list", "label": "列表" }
      ]
    },
    {
      "key": "show_summary",
      "type": "boolean",
      "label": "显示顶部概览",
      "default": true
    },
    { "type": "title", "label": "页面背景" },
    {
      "key": "background_image_url",
      "type": "string",
      "label": "背景图片 API 地址",
      "default": "",
      "help": "直接返回图片的 API 地址；同一地址自适应手机与桌面"
    },
    {
      "key": "global_transparency",
      "type": "number",
      "label": "全局透明度",
      "default": 20,
      "min": 0,
      "max": 70,
      "help": "调整卡片、顶栏与详情面板的透明度；数值越大，背景越明显"
    },
    { "type": "title", "label": "延迟监控" },
    {
      "key": "show_carrier_latency",
      "type": "boolean",
      "label": "在节点视图显示延迟",
      "default": true
    }
  ]
}
